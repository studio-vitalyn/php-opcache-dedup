diff --git a/ext/opcache/tests/dedup/dedup.inc b/ext/opcache/tests/dedup/dedup.inc
new file mode 100644
index 00000000..b31b9f24
--- /dev/null
+++ b/ext/opcache/tests/dedup/dedup.inc
@@ -0,0 +1,38 @@
+<?php
+
+/* Writes $code to <tests/dedup>/<$name>/<$site>/<$file> for each site and
+ * returns the absolute paths, keyed by site. */
+function dedup_make_sites(string $name, string $code, array $sites = ['a', 'b'], string $file = 'lib.php'): array
+{
+    $paths = [];
+    foreach ($sites as $site) {
+        $dir = __DIR__ . "/$name/$site";
+        if (!is_dir($dir)) {
+            mkdir($dir, 0777, true);
+        }
+        file_put_contents("$dir/$file", $code);
+        $paths[$site] = "$dir/$file";
+    }
+    return $paths;
+}
+
+function dedup_remove_sites(string $name): void
+{
+    $base = __DIR__ . "/$name";
+    if (!is_dir($base)) {
+        return;
+    }
+    $it = new RecursiveIteratorIterator(
+        new RecursiveDirectoryIterator($base, FilesystemIterator::SKIP_DOTS),
+        RecursiveIteratorIterator::CHILD_FIRST
+    );
+    foreach ($it as $entry) {
+        $entry->isDir() ? rmdir($entry->getPathname()) : unlink($entry->getPathname());
+    }
+    rmdir($base);
+}
+
+function dedup_stats(): array
+{
+    return opcache_get_status(false)['dedup'];
+}
diff --git a/ext/opcache/tests/dedup/dedup_basic.phpt b/ext/opcache/tests/dedup/dedup_basic.phpt
new file mode 100644
index 00000000..52d66844
--- /dev/null
+++ b/ext/opcache/tests/dedup/dedup_basic.phpt
@@ -0,0 +1,60 @@
+--TEST--
+opcache.enable_dedup: identical files at different paths share their opcodes
+--EXTENSIONS--
+opcache
+--INI--
+opcache.enable=1
+opcache.enable_cli=1
+opcache.enable_dedup=1
+opcache.file_update_protection=0
+opcache.jit_buffer_size=0
+--FILE--
+<?php
+require __DIR__ . '/dedup.inc';
+
+$paths = dedup_make_sites('dedup_basic', <<<'PHP'
+<?php
+/* Declared at runtime, so that both copies can be compiled in one process */
+if (!function_exists('dedup_basic_sum')) {
+    function dedup_basic_sum(array $values): int
+    {
+        $sum = 0;
+        foreach ($values as $value) {
+            $sum += $value;
+        }
+        return $sum;
+    }
+}
+PHP);
+
+var_dump(dedup_stats()['enabled']);
+var_dump(opcache_compile_file($paths['a']));
+$before = dedup_stats();
+var_dump(opcache_compile_file($paths['b']));
+$after = dedup_stats();
+
+/* The function is shared. The main script is too, except on PHP 8.0 where
+ * it holds the path-dependent runtime definition key of the function. */
+var_dump($after['hits'] - $before['hits'] >= 1);
+var_dump($after['hits'] + $after['misses'] - $before['hits'] - $before['misses']);
+var_dump($after['saved_memory'] > $before['saved_memory']);
+var_dump(opcache_is_script_cached($paths['a']), opcache_is_script_cached($paths['b']));
+
+include $paths['b'];
+var_dump(dedup_basic_sum([1, 2, 3]));
+?>
+--CLEAN--
+<?php
+require __DIR__ . '/dedup.inc';
+dedup_remove_sites('dedup_basic');
+?>
+--EXPECT--
+bool(true)
+bool(true)
+bool(true)
+bool(true)
+int(2)
+bool(true)
+bool(true)
+bool(true)
+int(6)
diff --git a/ext/opcache/tests/dedup/dedup_classes.phpt b/ext/opcache/tests/dedup/dedup_classes.phpt
new file mode 100644
index 00000000..01a82199
--- /dev/null
+++ b/ext/opcache/tests/dedup/dedup_classes.phpt
@@ -0,0 +1,95 @@
+--TEST--
+opcache.enable_dedup: classes, inheritance, traits and static variables
+--EXTENSIONS--
+opcache
+--INI--
+opcache.enable=1
+opcache.enable_cli=1
+opcache.enable_dedup=1
+opcache.file_update_protection=0
+opcache.jit_buffer_size=0
+--FILE--
+<?php
+require __DIR__ . '/dedup.inc';
+
+$paths = dedup_make_sites('dedup_classes', <<<'PHP'
+<?php
+namespace DedupClasses;
+
+/* Declared at runtime, so that both copies can be compiled in one process */
+if (!trait_exists(Counts::class, false)) {
+    trait Counts
+    {
+        public function next(): int
+        {
+            static $calls = 0;
+            return ++$calls;
+        }
+    }
+
+    abstract class Shape
+    {
+        public const UNIT = 'cm';
+
+        abstract public function area(): float;
+
+        public function describe(): string
+        {
+            return sprintf('%s: %.2f %s2', static::class, $this->area(), self::UNIT);
+        }
+    }
+
+    final class Square extends Shape
+    {
+        use Counts;
+
+        public function __construct(private float $side) {}
+
+        public function area(): float
+        {
+            return $this->side ** 2;
+        }
+    }
+
+    final class Circle extends Shape
+    {
+        use Counts;
+
+        public function __construct(private float $radius) {}
+
+        public function area(): float
+        {
+            return M_PI * $this->radius ** 2;
+        }
+    }
+}
+PHP);
+
+var_dump(opcache_compile_file($paths['a']));
+$before = dedup_stats();
+var_dump(opcache_compile_file($paths['b']));
+$after = dedup_stats();
+var_dump($after['hits'] - $before['hits'] >= 5);
+
+include $paths['b'];
+$square = new DedupClasses\Square(3);
+$circle = new DedupClasses\Circle(1);
+echo $square->describe(), "\n", $circle->describe(), "\n";
+var_dump($square->next(), $square->next(), $circle->next());
+var_dump((new ReflectionMethod($square, 'describe'))->getFileName() === $paths['b']);
+?>
+--CLEAN--
+<?php
+require __DIR__ . '/dedup.inc';
+dedup_remove_sites('dedup_classes');
+?>
+--EXPECT--
+bool(true)
+bool(true)
+bool(true)
+DedupClasses\Square: 9.00 cm2
+DedupClasses\Circle: 3.14 cm2
+int(1)
+int(2)
+int(1)
+bool(true)
diff --git a/ext/opcache/tests/dedup/dedup_cotenant_write.phpt b/ext/opcache/tests/dedup/dedup_cotenant_write.phpt
new file mode 100644
index 00000000..ecf711e0
--- /dev/null
+++ b/ext/opcache/tests/dedup/dedup_cotenant_write.phpt
@@ -0,0 +1,81 @@
+--TEST--
+opcache.enable_dedup: a tenant sharing a block cannot mutate it for the others
+--EXTENSIONS--
+opcache
+--INI--
+opcache.enable=1
+opcache.enable_cli=1
+opcache.enable_dedup=1
+opcache.file_update_protection=0
+opcache.jit_buffer_size=0
+--FILE--
+<?php
+require __DIR__ . '/dedup.inc';
+
+/* A and B have byte-identical code, so their op_array points at the same
+ * shared opcodes and the same shared literal (a constant array). A then does
+ * everything a hostile co-tenant can do from PHP to that block: mutate what
+ * the shared literal returns, feed it to functions, write to it by reference.
+ * B, and the shared memory, must be unaffected. There is no PHP API that
+ * writes opcodes or the persisted literal zvals; both are immutable in SHM. */
+$code = <<<'PHP'
+<?php
+return new class {
+    public function config(): array
+    {
+        return ['db' => ['user' => 'root', 'pass' => 'secret'], 'keys' => [1, 2, 3]];
+    }
+    public function run(string $s): string
+    {
+        return strtoupper($s);
+    }
+};
+PHP;
+$paths = dedup_make_sites('dedup_cotenant', $code);
+
+$before = dedup_stats();
+$a = include $paths['a'];
+$b = include $paths['b'];
+$shared = dedup_stats()['hits'] - $before['hits'];
+var_dump($shared >= 2);               /* config() and run() shared */
+
+/* A mutates every value it can reach from the shared literal */
+$cfg = $a->config();
+$cfg['db']['pass'] = 'OWNED';
+$cfg['keys'][] = 99;
+sort($cfg['keys']);
+$ref = &$cfg['db'];
+$ref['injected'] = true;
+unset($ref);
+$a->run('x');                          /* exercise the shared opcodes */
+
+/* B must still see the pristine constant, proving the shared literal was
+ * copied on write, never mutated in place */
+$bc = $b->config();
+var_dump($bc['db']['pass']);
+var_dump(array_key_exists('injected', $bc['db']));
+var_dump($bc['keys']);
+var_dump($b->run('abc'));
+
+/* A re-reads its own constant: also pristine (copy-on-write, not the mutated $cfg) */
+var_dump($a->config()['db']['pass']);
+?>
+--CLEAN--
+<?php
+require __DIR__ . '/dedup.inc';
+dedup_remove_sites('dedup_cotenant');
+?>
+--EXPECT--
+bool(true)
+string(6) "secret"
+bool(false)
+array(3) {
+  [0]=>
+  int(1)
+  [1]=>
+  int(2)
+  [2]=>
+  int(3)
+}
+string(3) "ABC"
+string(6) "secret"
