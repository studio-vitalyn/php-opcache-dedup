@@ -0,0 +1,55 @@
+--TEST--
+opcache.enable_dedup: blocks differing only in literal values are not shared
+--EXTENSIONS--
+opcache
+--INI--
+opcache.enable=1
+opcache.enable_cli=1
+opcache.enable_dedup=1
+opcache.file_update_protection=0
+opcache.jit_buffer_size=0
+--FILE--
+<?php
+require __DIR__ . '/dedup.inc';
+
+$template = <<<'PHP'
+<?php
+$file = __FILE__; /* keeps the main script out of the comparison */
+return static function () {
+    return [STR, INT, FLOAT, ARR];
+};
+PHP;
+$variants = [
+    'a' => ['"abc"', '1', '0.0', "['x' => 1, 'y' => [2]]"],
+    'b' => ['"abd"', '1', '0.0', "['x' => 1, 'y' => [2]]"],
+    'c' => ['"abc"', '2', '0.0', "['x' => 1, 'y' => [2]]"],
+    'd' => ['"abc"', '1', '-0.0', "['x' => 1, 'y' => [2]]"],
+    'e' => ['"abc"', '1', '0.0', "['y' => [2], 'x' => 1]"],
+    'f' => ['"abc"', '1', '0.0', "['x' => 1, 'y' => ['2']]"],
+    'g' => ['"abc"', '1', '0.0', "['x' => 1, 'y' => [2]]"], /* same as a */
+];
+
+$closures = [];
+foreach ($variants as $site => [$str, $int, $float, $arr]) {
+    $code = str_replace(['STR', 'INT', 'FLOAT', 'ARR'], [$str, $int, $float, $arr], $template);
+    $path = dedup_make_sites('dedup_literals', $code, [$site])[$site];
+    $before = dedup_stats();
+    $closures[$site] = include $path;
+    $after = dedup_stats();
+    echo $site, ': ', json_encode($closures[$site](), JSON_PRESERVE_ZERO_FRACTION), ' ',
+        $after['hits'] > $before['hits'] ? 'shared' : 'stored', "\n";
+}
+?>
+--CLEAN--
+<?php
+require __DIR__ . '/dedup.inc';
+dedup_remove_sites('dedup_literals');
+?>
+--EXPECT--
+a: ["abc",1,0.0,{"x":1,"y":[2]}] stored
+b: ["abd",1,0.0,{"x":1,"y":[2]}] stored
+c: ["abc",2,0.0,{"x":1,"y":[2]}] stored
+d: ["abc",1,-0.0,{"x":1,"y":[2]}] stored
+e: ["abc",1,0.0,{"y":[2],"x":1}] stored
+f: ["abc",1,0.0,{"x":1,"y":["2"]}] stored
+g: ["abc",1,0.0,{"x":1,"y":[2]}] shared
diff --git a/ext/opcache/tests/dedup/dedup_paths.phpt b/ext/opcache/tests/dedup/dedup_paths.phpt
new file mode 100644
index 00000000..b75c92b9
--- /dev/null
+++ b/ext/opcache/tests/dedup/dedup_paths.phpt
@@ -0,0 +1,88 @@
+--TEST--
+opcache.enable_dedup: __FILE__, __DIR__, exceptions and reflection stay per path
+--EXTENSIONS--
+opcache
+--INI--
+opcache.enable=1
+opcache.enable_cli=1
+opcache.enable_dedup=1
+opcache.file_update_protection=0
+opcache.jit_buffer_size=0
+--FILE--
+<?php
+require __DIR__ . '/dedup.inc';
+
+$paths = dedup_make_sites('dedup_paths', <<<'PHP'
+<?php
+return [
+    'file' => __FILE__,
+    'dir' => __DIR__,
+    'classify' => static function (int|string $value): string {
+        $kind = match (true) {
+            is_int($value) && $value < 0 => 'negative',
+            is_int($value) => 'positive',
+            default => 'string',
+        };
+        switch ($value) {
+            case 'alpha': return "$kind:first";
+            case 'beta': return "$kind:second";
+            case 'gamma': return "$kind:third";
+        }
+        return "$kind:other";
+    },
+    'thrower' => static function (): void {
+        throw new RuntimeException('boom');
+    },
+    'where' => static function (): string {
+        return __FILE__;
+    },
+];
+PHP);
+
+$before = dedup_stats();
+$a = include $paths['a'];
+$b = include $paths['b'];
+$after = dedup_stats();
+
+var_dump($a['file'] === $paths['a'], $b['file'] === $paths['b']);
+var_dump($a['dir'] === dirname($paths['a']), $b['dir'] === dirname($paths['b']));
+var_dump($a['where']() === $paths['a'], $b['where']() === $paths['b']);
+var_dump($a['classify']('beta'), $b['classify'](-3), $b['classify']('zeta'));
+
+foreach (['a' => $a, 'b' => $b] as $site => $lib) {
+    try {
+        $lib['thrower']();
+    } catch (RuntimeException $e) {
+        var_dump($e->getFile() === $paths[$site], $e->getLine());
+        var_dump($e->getTrace()[0]['file'] === __FILE__);
+    }
+    var_dump((new ReflectionFunction($lib['thrower']))->getFileName() === $paths[$site]);
+}
+
+/* "classify" and "thrower" are shared, "where" and the main script are not */
+var_dump($after['hits'] - $before['hits'] >= 2);
+?>
+--CLEAN--
+<?php
+require __DIR__ . '/dedup.inc';
+dedup_remove_sites('dedup_paths');
+?>
+--EXPECT--
+bool(true)
+bool(true)
+bool(true)
+bool(true)
+bool(true)
+bool(true)
+string(13) "string:second"
+string(14) "negative:other"
+string(12) "string:other"
+bool(true)
+int(19)
+bool(true)
+bool(true)
+bool(true)
+int(19)
+bool(true)
+bool(true)
+bool(true)
