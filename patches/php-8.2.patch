+$before = dedup_stats();
+$lib = include $paths['a'];
+$after = dedup_stats();
+echo $lib['greet']('a'), ' v', $lib['version'](), "\n";
+/* "greet" is unchanged and shared with the stale copy */
+var_dump($after['hits'] > $before['hits']);
+?>
+--CLEAN--
+<?php
+require __DIR__ . '/dedup.inc';
