+$paths = dedup_make_sites('dedup_invalidate', $v1, ['a']);
+$lib = include $paths['a'];
+echo $lib['greet']('a'), ' v', $lib['version'](), "\n";
+
+file_put_contents($paths['a'], $v2);
+touch($paths['a'], time() + 10);
