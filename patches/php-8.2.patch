diff --git a/ext/opcache/tests/dedup/dedup_shared_values.phpt b/ext/opcache/tests/dedup/dedup_shared_values.phpt
new file mode 100644
index 00000000..d2dd421a
--- /dev/null
+++ b/ext/opcache/tests/dedup/dedup_shared_values.phpt
@@ -0,0 +1,72 @@
+--TEST--
+opcache.enable_dedup: array literals shared by several op_arrays of a script
+--EXTENSIONS--
+opcache
+--INI--
+opcache.enable=1
+opcache.enable_cli=1
+opcache.enable_dedup=1
+opcache.file_update_protection=0
+opcache.jit_buffer_size=0
+--FILE--
+<?php
+require __DIR__ . '/dedup.inc';
+
+/* The optimizer substitutes self::MAP into the methods, so the same nested
+ * arrays end up in the literals of several op_arrays and in the constant
+ * table. The first of them to be persisted moves them to SHM; the others,
+ * shared or not, must follow the xlat table instead of the freed copy. */
+$paths = dedup_make_sites('dedup_shared_values', <<<'PHP'
+<?php
+namespace DedupSharedValues;
+
+if (!class_exists(Registry::class, false)) {
+    final class Registry
+    {
+        public const MAP = ['colors' => ['red' => 1, 'green' => 2], 'sizes' => ['s', 'm', 'l']];
+
+        public function all(): array
+        {
+            return self::MAP;
+        }
+
+        public function colors(): array
+        {
+            return self::MAP['colors'];
+        }
+
+        public function sizes(): array
+        {
+            return self::MAP['sizes'];
+        }
+
+        public function nested(): array
+        {
+            return ['map' => self::MAP, 'colors' => self::MAP['colors']];
+        }
+    }
+}
+PHP, ['a', 'b', 'c']);
+
+$before = dedup_stats();
+foreach ($paths as $path) {
+    var_dump(opcache_compile_file($path));
+}
+$after = dedup_stats();
+var_dump($after['hits'] - $before['hits'] >= 8);
+
+include $paths['c'];
+$registry = new DedupSharedValues\Registry();
+echo json_encode([$registry->all(), $registry->colors(), $registry->sizes(), $registry->nested()]), "\n";
+?>
+--CLEAN--
+<?php
+require __DIR__ . '/dedup.inc';
+dedup_remove_sites('dedup_shared_values');
+?>
+--EXPECT--
+bool(true)
+bool(true)
+bool(true)
+bool(true)
+[{"colors":{"red":1,"green":2},"sizes":["s","m","l"]},{"red":1,"green":2},["s","m","l"],{"map":{"colors":{"red":1,"green":2},"sizes":["s","m","l"]},"colors":{"red":1,"green":2}}]
diff --git a/ext/opcache/tests/dedup/dedup_variants.phpt b/ext/opcache/tests/dedup/dedup_variants.phpt
new file mode 100644
index 00000000..1b30c50f
--- /dev/null
+++ b/ext/opcache/tests/dedup/dedup_variants.phpt
@@ -0,0 +1,91 @@
+--TEST--
+opcache.enable_dedup: two docroots with the same layout, where some functions differ
+--EXTENSIONS--
+opcache
+--INI--
+opcache.enable=1
+opcache.enable_cli=1
+opcache.enable_dedup=1
+opcache.file_update_protection=0
+opcache.jit_buffer_size=0
+--FILE--
+<?php
+require __DIR__ . '/dedup.inc';
+
+/* name => [code in docroot a, code in docroot b, arguments] */
+$variants = [
+    /* one difference: never shared, each copy keeps its own behaviour */
+    'operator'   => ['fn ($a, $b) => $a + $b', 'fn ($a, $b) => $a - $b', [5, 3]],
+    'comparison' => ['fn ($a) => $a < 3 ? "lt" : "ge"', 'fn ($a) => $a <= 3 ? "lt" : "ge"', [3]],
+    'int'        => ['fn () => 10', 'fn () => 11', []],
+    'string'     => ['fn () => "abc"', 'fn () => "abd"', []],
+    'float'      => ['fn () => 0.1 + 0.2', 'fn () => 0.1 + 0.3', []],
+    'branches'   => ['function ($x) { if ($x) { return "yes"; } return "no"; }', 'function ($x) { if ($x) { return "no"; } return "yes"; }', [true]],
+    'call'       => ['fn ($s) => strtoupper($s)', 'fn ($s) => strtolower($s)', ['MiXeD']],
+    'arg_order'  => ['fn ($a, $b) => $a . $b', 'fn ($a, $b) => $b . $a', ['x', 'y']],
+    'statement'  => ['function ($a) { $a *= 2; return $a; }', 'function ($a) { $a *= 2; $a++; return $a; }', [4]],
+    'default'    => ['fn ($a = 1) => $a', 'fn ($a = 2) => $a', []],
+    'array'      => ['fn () => json_encode(["x" => 1, "y" => 2])', 'fn () => json_encode(["y" => 2, "x" => 1])', []],
+    'match'      => ['fn ($v) => match ($v) { 1 => "one", 2 => "two", default => "other" }', 'fn ($v) => match ($v) { 1 => "one", 2 => "deux", default => "other" }', [2]],
+    'switch'     => ['function ($s) { switch ($s) { case "a": return 1; case "b": return 2; } return 0; }', 'function ($s) { switch ($s) { case "a": return 1; case "c": return 2; } return 0; }', ['b']],
+    'catch'      => ['function () { try { throw new LogicException("x"); } catch (LogicException $e) { return "caught"; } catch (Exception $e) { return "generic"; } }',
+                     'function () { try { throw new LogicException("x"); } catch (RuntimeException $e) { return "caught"; } catch (Exception $e) { return "generic"; } }', []],
+    /* same opcodes, different metadata (variable names, types, initial
+     * values of static variables): shared, metadata stays per function */
+    'static'     => ['function () { static $n = 0; return ++$n; }', 'function () { static $n = 100; return ++$n; }', []],
+    'var_name'   => ['fn ($a) => $a * 3', 'fn ($b) => $b * 3', [7]],
+    'param_type' => ['function (int $x) { return gettype($x); }', 'function (string $x) { return gettype($x); }', ['42']],
+    'return_type'=> ['function ($x): int { return $x; }', 'function ($x): string { return $x; }', ['5']],
+    'identical'  => ['fn ($a) => $a * 2', 'fn ($a) => $a * 2', [21]],
+    /* last, as it shifts the lines that follow: different line, not shared */
+    'line'       => ['fn () => __LINE__', "\n" . 'fn () => __LINE__', []],
+];
+
+$sources = ['a' => "<?php\nreturn [\n", 'b' => "<?php\nreturn [\n"];
+foreach ($variants as $name => [$a, $b]) {
+    $sources['a'] .= "'$name' => $a,\n";
+    $sources['b'] .= "'$name' => $b,\n";
+}
+$paths = [];
+foreach ($sources as $root => $code) {
+    $paths[$root] = dedup_make_sites('dedup_variants', $code . "];\n", [$root])[$root];
+}
+
+$a = include $paths['a'];
+$before = dedup_stats()['hits'];
+$b = include $paths['b'];
+$shared = dedup_stats()['hits'] - $before;
+
+foreach ($variants as $name => [, , $args]) {
+    printf("%-11s a=%s b=%s\n", $name,
+        var_export($a[$name](...$args), true), var_export($b[$name](...$args), true));
+}
+echo "shared by docroot b: $shared\n";
+?>
+--CLEAN--
+<?php
+require __DIR__ . '/dedup.inc';
+dedup_remove_sites('dedup_variants');
+?>
+--EXPECT--
+operator    a=8 b=2
+comparison  a='ge' b='lt'
+int         a=10 b=11
+string      a='abc' b='abd'
+float       a=0.30000000000000004 b=0.4
+branches    a='yes' b='no'
+call        a='MIXED' b='mixed'
+arg_order   a='xy' b='yx'
+statement   a=8 b=9
+default     a=1 b=2
+array       a='{"x":1,"y":2}' b='{"y":2,"x":1}'
+match       a='two' b='deux'
+switch      a=2 b=0
+catch       a='caught' b='generic'
+static      a=1 b=101
+var_name    a=21 b=21
+param_type  a='integer' b='string'
+return_type a=5 b='5'
+identical   a=42 b=42
+line        a=22 b=23
+shared by docroot b: 5
diff --git a/ext/opcache/tests/dedup/dedup_vendored.phpt b/ext/opcache/tests/dedup/dedup_vendored.phpt
new file mode 100644
index 00000000..b1f00f6e
--- /dev/null
+++ b/ext/opcache/tests/dedup/dedup_vendored.phpt
@@ -0,0 +1,77 @@
+--TEST--
+opcache.enable_dedup: identical methods of differently named classes are shared
+--EXTENSIONS--
+opcache
+--INI--
+opcache.enable=1
+opcache.enable_cli=1
+opcache.enable_dedup=1
+opcache.file_update_protection=0
+opcache.jit_buffer_size=0
+--FILE--
+<?php
+require __DIR__ . '/dedup.inc';
+
+/* Same library vendored under two prefixes, declared at compile time */
+$template = <<<'PHP'
+<?php
+namespace PREFIX\Lib;
+
+class Base
+{
+    protected array $items = [];
+
+    public function add(string $item): static
+    {
+        $this->items[] = \trim($item);
+        return $this;
+    }
+
+    public function count(): int
+    {
+        return \count($this->items);
+    }
+}
+
+class Collection extends Base
+{
+    public function join(string $glue = ', '): string
+    {
+        return \implode($glue, $this->items);
+    }
+}
+PHP;
+
+$paths = [];
+foreach (['Acme', 'Other'] as $prefix) {
+    $paths[$prefix] = dedup_make_sites('dedup_vendored', str_replace('PREFIX', $prefix, $template), [$prefix])[$prefix];
+}
+
+$before = dedup_stats();
+include $paths['Acme'];
+$middle = dedup_stats();
+include $paths['Other'];
+$after = dedup_stats();
+
+var_dump($middle['hits'] === $before['hits']);
+/* add(), count() and join() */
+var_dump($after['hits'] - $middle['hits'] >= 3);
+
+foreach (['Acme\Lib\Collection', 'Other\Lib\Collection'] as $class) {
+    $c = (new $class)->add(' x ')->add('y');
+    echo $class, ': ', $c->join(), ' (', $c->count(), ")\n";
+    var_dump((new ReflectionMethod($class, 'count'))->getDeclaringClass()->getName());
+}
+?>
+--CLEAN--
+<?php
+require __DIR__ . '/dedup.inc';
+dedup_remove_sites('dedup_vendored');
+?>
+--EXPECT--
+bool(true)
+bool(true)
+Acme\Lib\Collection: x, y (2)
+string(13) "Acme\Lib\Base"
+Other\Lib\Collection: x, y (2)
+string(14) "Other\Lib\Base"
diff --git a/ext/opcache/zend_accelerator_dedup.c b/ext/opcache/zend_accelerator_dedup.c
